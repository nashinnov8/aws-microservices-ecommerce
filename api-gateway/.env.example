# API Gateway Environment Variables Template
# Copy this file to .env and fill in your actual values
# ALL VALUES ARE REQUIRED - No defaults are set in application-dev.yml

# Server Configuration (REQUIRED)
SERVER_PORT=8000

# Spring Cloud Gateway Routes (REQUIRED)
SPRING_CLOUD_GATEWAY_ROUTES_AUTH_URI=http://auth-service:8080
SPRING_CLOUD_GATEWAY_ROUTES_PRODUCT_URI=http://product-service:8081

# JWT Configuration (REQUIRED - must match Auth Service)
JWT_SECRET=your_jwt_secret_key_min_32_characters_long_here

# Redis Configuration (REQUIRED)
SPRING_REDIS_HOST=redis
SPRING_REDIS_PORT=6379
SPRING_REDIS_PASSWORD=
SPRING_REDIS_TIMEOUT=60000

# Rate Limiting Configuration (REQUIRED)
RATE_LIMIT_CAPACITY=100
RATE_LIMIT_REFILL_TOKENS=100
RATE_LIMIT_REFILL_PERIOD=60

# Logging Configuration (REQUIRED)
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_API_GATEWAY=DEBUG

