# Auth Service Environment Variables Template
# Copy this file to .env and fill in your actual values
# ALL VALUES ARE REQUIRED - No defaults are set in application-dev.yml

# Database Configuration (REQUIRED)
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/auth_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Ho_Chi_Minh
SPRING_DATASOURCE_USERNAME=auth_user
SPRING_DATASOURCE_PASSWORD=auth_password

# JPA Configuration (REQUIRED)
JPA_HIBERNATE_DDL_AUTO=update
JPA_DATABASE_PLATFORM=org.hibernate.dialect.MySQLDialect
JPA_SHOW_SQL=true
JPA_FORMAT_SQL=true

# Mail Configuration (REQUIRED)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS_ENABLE=true
MAIL_DEFAULT_ENCODING=utf-8

# JWT Configuration (REQUIRED)
JWT_SECRET=your_jwt_secret_key_min_32_characters_long_here
JWT_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=86400000
JWT_VERIFICATION_EXPIRATION=3600000
JWT_EMAIL_VERIFICATION_EXPIRATION=3600000
JWT_PASSWORD_RESET_EXPIRATION=3600000

# Logging Configuration (REQUIRED)
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_AUTH_SERVICE=DEBUG

# Application Configuration (REQUIRED)
APP_BASE_URL=http://localhost:8080
