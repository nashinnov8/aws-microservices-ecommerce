# Product Service Environment Variables Template
# Copy this file to .env and fill in your actual values
# ALL VALUES ARE REQUIRED - No defaults are set in application-dev.yml

# Database Configuration (REQUIRED)
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/product_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Ho_Chi_Minh
SPRING_DATASOURCE_USERNAME=ecommerce
SPRING_DATASOURCE_PASSWORD=ecommerce

# JPA Configuration (REQUIRED)
JPA_HIBERNATE_DDL_AUTO=update
JPA_DATABASE_PLATFORM=org.hibernate.dialect.MySQLDialect
JPA_SHOW_SQL=true
JPA_FORMAT_SQL=true

# Logging Configuration (REQUIRED)
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_PRODUCT_SERVICE=DEBUG

# Application Configuration (REQUIRED)
APP_BASE_URL=http://localhost:8081
